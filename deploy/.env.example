# ============================================================
# 云端看板 · 服务器端环境变量
#
#   cp .env.example .env
#   然后逐项修改，尤其是标了 ★ 的
#
# 这个文件只放在服务器上（deploy/.env），不要提交到 git。
# ============================================================

# ------------------------------------------------------------
# 一、部署基础（compose 用）
# ------------------------------------------------------------

# ★ 数据库密码：请换成一串长随机值。
#     openssl rand -hex 24          ← 推荐（纯十六进制，绝对安全）
#
#   ⚠ 不要用 base64（openssl rand -base64 ...）：它会产出 '/' 和 '#'，
#     而 compose 是把密码拼进 DATABASE_URL 的：
#         postgresql://用户:密码@db:5432/库名
#     · 密码含 '/' 或 '#' → pg 抛 ERR_INVALID_URL，api 容器直接起不来
#     · 密码含 '%'        → 会被 URL 解码，密码静默变成另一个值，报认证失败
#   最省事的做法：跑 ./gen-env.sh，它会生成 URL 安全的随机密码并写好整份 .env
POSTGRES_PASSWORD=请改成一串长随机密码
POSTGRES_DB=cloud_dashboard
POSTGRES_USER=cloud_dashboard

# ★ 站点地址，决定 Caddy 怎么提供访问：
#   - 有域名：kanban.example.com
#       Caddy 会自动申请并续期 HTTPS 证书，强制跳转 https
#       前提：域名 A 记录已指向本机、且 80/443 可从公网访问
#   - 暂时只有 IP、先跑起来看看：:80
#       纯 HTTP，不申请证书
#   本机自测可以用 localhost（Caddy 对 localhost 用内部自签证书）
SITE_ADDRESS=:80

# ------------------------------------------------------------
# 二、登录与安全（★ 这一节必须逐项检查）
# ------------------------------------------------------------

# ★ 账号密码。多账号用英文逗号分隔：user1=pass1:角色,user2=pass2:角色
#   注意：这一项一旦有值，就会覆盖下面的 LOGIN_USER / LOGIN_PASSWORD
#   原来的 4111/4111 是本地弱口令，放到公网上必须在开放访问前换掉
#
#   角色两种（可省略，省略即 admin）：
#     admin  管理员 —— 全部功能：看板 + 立即同步 + 导出 Excel + 改备注 + 系统管理
#     member 成员   —— 看板 + 导出 Excel + 改明细备注（同步、系统管理仍限管理员）
#
#   典型配法（给财务/业务同事发成员账号，自己留管理员）：
#     LOGIN_USERS=zhangsan=Kf7xQ2mP9a:admin,lisi=Rt4bW8nE3s:member
#   角色改动即时生效：改完这一行重启服务即可，不必等旧令牌过期。
#   运行日志里会打印每个账号的角色，方便确认没配错。
#
#   ⚠ 用户名和密码都不能包含英文逗号 , 或等号 =（这两个字符是该格式的分隔符）
#   ⚠ 密码里可以出现冒号 :（会从末尾识别角色），但角色名别写错 ——
#     写成像 `abc:viewerr` 这样会被当成整个密码，结果是登不上，而不是悄悄放权。
#
#   ⚠ 这一项留空 + NODE_ENV=production（compose 里已强制）→ 服务会【拒绝启动】。
#     因为鉴权在「没有账号」时是放行的，留空等于把看板零认证挂到公网。
#     确实要做无人认证的公开只读看板，才显式设置下面的 ALLOW_ANONYMOUS_ACCESS。
LOGIN_USERS=

# 单账号写法（LOGIN_USERS 为空时生效）
LOGIN_USER=
LOGIN_PASSWORD=

# ★ 令牌签名盐值。必须设置成一串长随机值，例如：
#     openssl rand -hex 32
#   不设置会退回用容器主机名当盐值：既不安全，容器重建还会让所有人掉线
AUTH_SECRET=

# 令牌有效期（小时）：普通登录 / 勾了「记住我」
LOGIN_TTL_HOURS=12
LOGIN_REMEMBER_TTL_HOURS=168

# 登录限流：同一 IP 在 WINDOW 分钟内失败 MAX 次即锁定
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW_MINUTES=15

# 反向代理（生产环境由 compose 强制设为 true，这里不用改）
TRUST_PROXY=true

# 逃生舱：确认要做「无人认证的公开只读看板」时才设 true。
# 不设置时，生产环境 + 未配账号 = 拒绝启动（防止漏填 LOGIN_USERS 导致数据裸奔）。
ALLOW_ANONYMOUS_ACCESS=false

# ------------------------------------------------------------
# 三、数据同步
# ------------------------------------------------------------

# 定时自动同步（从金山文档抓取 → 入库）。开启后无需手工点「立即同步」
KDOCS_SCHEDULER_ENABLED=false
# 轮询间隔（分钟），最小 1
KDOCS_SCHEDULER_INTERVAL_MIN=60

# 同步卡死锁的自愈阈值（分钟）与孤儿进程回收开关
SYNC_STALE_AFTER_MINUTES=20
SYNC_REAP_ORPHAN=true

# ------------------------------------------------------------
# 四、以下由 docker-compose.yml 自动注入，不要在这里重复设置
# ------------------------------------------------------------
# DATABASE_URL       ← 用上面的 POSTGRES_* 自动拼（指向 db 容器）
# PORT / NODE_ENV    ← 3000 / production
# PYTHON_PATH        ← python3
# KDOCS_PULL_SCRIPT  ← /data/kdocs/kdocs_pull.py
# EXPORT_DIR         ← /data/应收看板-数据导出
# IMPORT_WATCH_ENABLED ← false（容器里没有桌面文件夹监控）
