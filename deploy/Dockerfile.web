# ============================================================
# 前端镜像：多阶段构建
#   Stage 1 用 Node 把 Vue 打成静态文件
#   Stage 2 用 Caddy 提供服务（顺带做 HTTPS 和 /api 反向代理）
#
# 构建上下文 = 项目根目录：
#   docker build -f deploy/Dockerfile.web -t cloud-dashboard-web .
# ============================================================
FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci && npm cache clean --force

COPY . .

# 前端请求走同源 /api（src/api/request.js 里 baseURL 默认就是 '/api'），
# 由 Caddy 反代到 api 服务，因此不需要注入任何后端地址。
RUN npm run build


FROM caddy:2-alpine

# 静态产物
COPY --from=build /app/dist /srv

# Caddy 配置（站点地址由环境变量 SITE_ADDRESS 决定）
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

# 用 Caddy 自己的管理接口做存活检查。
# 不用 :80 是因为配了域名时 80 会 308 跳到 443，wget --spider 会因证书域名不匹配而失败。
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:2019/config/ || exit 1
