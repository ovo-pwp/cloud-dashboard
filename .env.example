# 数据库连接串
# 格式：postgresql://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_dashboard

# 后端服务端口
PORT=3000

# 监听地址：0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机
HOST=0.0.0.0

# 运行环境 development | production
NODE_ENV=development

# 是否由后端托管前端构建产物（dist/）
# 生产部署设为 true，只跑一个进程一个端口；开发时保持 false 走 Vite dev server
SERVE_STATIC=false

# 文件夹监控自动导入（检测到业务类型 Excel 出现/变化即自动入库）
# IMPORT_WATCH_ENABLED=true
# IMPORT_WATCH_FOLDER=C:/Users/Administrator/Desktop
# IMPORT_WATCH_INTERVAL=15000

# ---------- 登录（保护整个看板）----------
# 多账号写法：逗号分隔的「用户名=密码」列表
# LOGIN_USERS=yourname=yourpassword
# 全部留空 = 关闭登录保护（不推荐）
LOGIN_TTL_HOURS=12
LOGIN_REMEMBER_TTL_HOURS=168

# ---------- 登录限流（防止暴力破解）----------
# 同一 IP 在窗口内失败达到 LOGIN_MAX_FAILS 次后将被拒绝登录
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW_MINUTES=15
# 是否信任 X-Forwarded-For（仅当前面挂了反向代理时才开启，否则限流可被伪造绕过）
TRUST_PROXY=false

# 登录日志保留天数（调度器每天清理一次旧记录；默认 180，最低 30）
# LOGIN_LOG_KEEP_DAYS=180

# ---------- 数据同步 ----------
# 同步状态与运行记录持久化在数据库表 sync_run，后端重启不会丢；
# 同一时刻只允许一个同步任务（网页按钮 / 定时轮询共用一把数据库锁）。
#
# 同步中途后端被杀，可能留下孤儿进程继续写库。下次启动会先校验该 PID 的命令行
# 确实是本项目的 sync.js，再终止它；设为 false 则只告警不动手。
SYNC_REAP_ORPHAN=true

# 「卡死的锁」判定阈值（分钟）：主动同步时若发现锁超过该时长未释放、
# 且记录的 PID 已不存在，就自动回收后重试一次。启动时的恢复不受此限制。
SYNC_STALE_AFTER_MINUTES=20

# 金山文档定时轮询（不设 = 关闭，保持「网页端手动同步」模式）
# KDOCS_SCHEDULER_ENABLED=false
# KDOCS_SCHEDULER_INTERVAL_MIN=60

# ---------- 登录验证码（2026-10-19）----------
# 服务端出算术题，答案不下发；token 一次性、5 分钟过期。
# 只挡「直接 POST 撞库」的脚本，挡不住会解析题面的定向程序；要更强请换 Cloudflare Turnstile。
# LOGIN_CAPTCHA_ENABLED=true
# 本机回环（::1 / 127.0.0.1）免验证码 —— 给本机验证脚本用；
# 公网请求经 Tunnel 会带真实 IP（TRUST_PROXY=true），不受这条影响。
# LOGIN_CAPTCHA_LOCAL_BYPASS=true

# ---------- 内网穿透（Cloudflare Tunnel）----------
# 本机局域网外访问时使用。需要：
#   1. 在 Cloudflare Zero Trust 创建 Tunnel，记录 TUNNEL_UUID
#   2. 设置 YOUR_HOSTNAME（如 kanban.example.com），并确保 DNS CNAME 指向 <TUNNEL_UUID>.cfargotunnel.com
#   3. 首次运行需做身份验证：node deploy/tunnel/setup-tunnel.cjs
#   4. 之后用 node deploy/tunnel/start-tunnel.cjs 启动
# 注意：Tunnel 仅转发 /api/*，前端静态文件由本地 Vite dev server 提供，
#       访问 https://YOUR_HOSTNAME 时会混合协议（HTTPS 页面 + HTTP API），
#       如需纯 HTTPS 请改用 deploy/ 下的 docker-compose 部署方案。
# TUNNEL_ENABLED=false
# TUNNEL_UUID=
# YOUR_HOSTNAME=
