# 数据库连接串
# 格式：postgresql://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_dashboard

# 后端服务端口
PORT=3000

# 监听地址：0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机
HOST=0.0.0.0

# 运行环境 development | production
NODE_ENV=development

# 是否由后端托管前端构建产物（dist/）
# 生产部署设为 true，只跑一个进程一个端口；开发时保持 false 走 Vite dev server
SERVE_STATIC=false

# 文件夹监控自动导入（检测到业务类型 Excel 出现/变化即自动入库）
# IMPORT_WATCH_ENABLED=true
# IMPORT_WATCH_FOLDER=C:/Users/Administrator/Desktop
# IMPORT_WATCH_INTERVAL=15000

# ---------- 登录（保护整个看板）----------
# 多账号写法：逗号分隔的「用户名=密码」列表
# LOGIN_USERS=yourname=yourpassword
# 全部留空 = 关闭登录保护（不推荐）
LOGIN_TTL_HOURS=12
LOGIN_REMEMBER_TTL_HOURS=168

# ---------- 登录限流（防止暴力破解）----------
# 同一 IP 在窗口内失败达到 LOGIN_MAX_FAILS 次后将被拒绝登录
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW_MINUTES=15
# 是否信任 X-Forwarded-For（仅当前面挂了反向代理时才开启，否则限流可被伪造绕过）
TRUST_PROXY=false
